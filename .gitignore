# Крупные рендеры и локальные медиа остаются вне git
*.mp4
video_studio/reels/output/
video_studio/reels/media/
video_studio/reels/products/*/media/
video_studio/reels/narration.*
video_studio/reels/captions.srt
*.timeline.json
*.qc.json
__pycache__/

# --- «В ОКОПЕ»: рабочие данные и зависимости ---
# Каталог поставщика приходит артефактом из GitHub Actions, в git его не кладём
catalog/data/
catalog/photos/
# Результаты генераторов (карточки, посты) — рабочие, живут до ручной выгрузки
vk/out/
media/blank/out*
media/blank/*.tmp
# Локальные Python-зависимости (ставит tools/bootstrap.sh)
vendor/

# Внешние файлы, скачанные через assets-inbox (докачка из интернета)
assets/inbox/

# Фото внутри собранных недельных папок (нужны только в ZIP, в git не кладём)
vk/posts/pack_*/**/*.jpg

# Листы закупки (внутренние цены) — не публикуем
prices/

# Рабочая выгрузка объявлений (в git идёт только архив)
avito_out/

# Выгрузка поставщика front-ts.ru (данные и фото браузером, не в git)
suppliers/frontts/data/
!suppliers/frontts/data/urls.txt
suppliers/frontts/photos/
